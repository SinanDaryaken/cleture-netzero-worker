APP_NAME="Cleture NetZero Worker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=central
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=moduler_netzero
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer

TENANT_PROVISIONER_CONNECTION=tenant_provisioner
TENANT_PROVISIONER_DB_URL=
TENANT_PROVISIONER_DB_HOST=postgres
TENANT_PROVISIONER_DB_PORT=5432
TENANT_PROVISIONER_DB_DATABASE=postgres
TENANT_PROVISIONER_DB_USERNAME=
TENANT_PROVISIONER_DB_PASSWORD=
TENANT_PROVISIONER_DB_SSLMODE=prefer

TENANT_RUNTIME_CONNECTION=tenant_template
TENANT_RUNTIME_DB_URL=
TENANT_RUNTIME_DB_HOST=postgres
TENANT_RUNTIME_DB_PORT=5432
TENANT_RUNTIME_DB_DATABASE=postgres
TENANT_RUNTIME_DB_USERNAME=
TENANT_RUNTIME_DB_PASSWORD=
TENANT_RUNTIME_DB_SSLMODE=prefer
TENANT_DATABASE_PREFIX=netzero_

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=central
DB_QUEUE_TABLE=jobs
DB_QUEUE=identity-mails,tenant-provisioning,emission-candidate-ingest
DB_QUEUE_RETRY_AFTER=330
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

PROCESSING_TASK_CONNECTION=central
PROCESSING_TASK_QUEUE_CONNECTION=database
PROCESSING_TASK_WORKER_ID=cleture-netzero-worker
PROCESSING_TASK_LEASE_SECONDS=60
PROCESSING_TASK_MAX_ATTEMPTS=5
PROCESSING_TASK_DISPATCH_BATCH_SIZE=25
PROCESSING_TASK_DISPATCH_STALE_AFTER_SECONDS=600
TENANT_PROVISIONING_QUEUE=tenant-provisioning
EMISSION_CANDIDATE_INGEST_CONNECTION=central
EMISSION_CANDIDATE_INGEST_QUEUE=emission-candidate-ingest
EMISSION_CANDIDATE_INGEST_DISK=candidate_ingress
EMISSION_CANDIDATE_MAX_ARTIFACT_SIZE_BYTES=536870912
EMISSION_CANDIDATE_MAX_UNCOMPRESSED_SIZE_BYTES=2147483648
EMISSION_CANDIDATE_MAX_LINE_SIZE_BYTES=8388608

IDENTITY_DB_CONNECTION=central
NETZERO_MY_URL=https://cleture-netzero-my.test
IDENTITY_EMAIL_VERIFICATION_PATH=/email/verify
IDENTITY_EMAIL_VERIFICATION_TOKEN_TABLE=organization_user_email_verification_tokens
IDENTITY_EMAIL_VERIFICATION_EXPIRE=60
IDENTITY_PASSWORD_RESET_PATH=/reset-password
IDENTITY_PASSWORD_BROKER=organization_users
ORGANIZATION_USER_PASSWORD_RESET_TOKEN_TABLE=organization_user_password_reset_tokens
ORGANIZATION_USER_PASSWORD_RESET_EXPIRE=60
ORGANIZATION_USER_PASSWORD_RESET_THROTTLE=60

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="netzero@cleture.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

CANDIDATE_INGRESS_ACCESS_KEY_ID=
CANDIDATE_INGRESS_SECRET_ACCESS_KEY=
CANDIDATE_INGRESS_REGION=us-east-1
CANDIDATE_INGRESS_BUCKET=
CANDIDATE_INGRESS_URL=
CANDIDATE_INGRESS_ENDPOINT=
CANDIDATE_INGRESS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
